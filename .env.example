# ============================================
#  WAJIB DIATUR SEBELUM DEPLOY KE PRODUCTION
# ============================================

# JWT Secret - minimal 32 karakter, acak, JANGAN dishare!
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=GANTI_DENGAN_SECRET_ACAK_MINIMAL_32_KARAKTER

# Environment mode
NODE_ENV=production

# CORS - daftar domain yang diizinkan (pisah dengan koma)
# Contoh: https://yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=

# Path database SQLite
DB_PATH=/app/data/users.db
